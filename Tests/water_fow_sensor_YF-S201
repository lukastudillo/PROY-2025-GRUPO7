from machine import Pin, Timer
import time

# --- CONFIGURACIÓN ---
SENSOR_PIN = 14  # Usa el GPIO que conectaste a la señal del sensor
CALIBRACION = 7.5  # Pulsos por segundo por litro/minuto (depende del sensor)
tiempo_medicion = 5  # segundos

# --- VARIABLES GLOBALES ---
pulsos = 0

# --- FUNCIÓN DE INTERRUPCIÓN ---
def contar_pulso(pin):
    global pulsos
    pulsos += 1

# --- CONFIGURACIÓN DE PIN ---
sensor = Pin(SENSOR_PIN, Pin.IN, Pin.PULL_UP)
sensor.irq(trigger=Pin.IRQ_FALLING, handler=contar_pulso)

# --- FUNCIÓN PRINCIPAL ---
def medir_agua():
    global pulsos
    while True:
        pulsos = 0
        print("⏳ Midiendo flujo de agua...")
        time.sleep(tiempo_medicion)

        # Cálculo de flujo en litros por minuto
        frecuencia = pulsos / tiempo_medicion  # pulsos por segundo
        flujo_lpm = frecuencia / CALIBRACION   # litros por minuto
        litros = flujo_lpm * (tiempo_medicion / 60)  # litros en el intervalo

        print(f"💧 Pulsos: {pulsos}")
        print(f"🚰 Flujo: {flujo_lpm:.3f} L/min")
        print(f"📦 Volumen estimado: {litros:.3f} litros\n")

        time.sleep(1)

# --- INICIO ---
medir_agua()
